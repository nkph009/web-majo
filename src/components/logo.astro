    <line x1="70" y1="107" x2="100" y2="145"/>
    <line x1="100" y1="107" x2="70" y2="145"/>
    <line x1="100" y1="107" x2="130" y2="145"/>
    <line x1="130" y1="107" x2="100" y2="145"/>
  </g>
</svg>