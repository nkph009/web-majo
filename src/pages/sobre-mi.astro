---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import majofoto from "../assets/images/majo1.jpeg";
import majofoto2 from "../assets/images/majo3.jpeg";

const FORMACION = [
  {
    year: "2018",
    title: "Grado en Psicología",
    // ✏️ Change university if needed
    place: "Universidad",
  },
  {
    year: "2020",
    title: "Máster en Psicología General Sanitaria",
    place: "UNIR",
  },
  {
    year: "2021 — hoy",
    title: "Formación en Terapia Sensoriomotriz",
    // ✏️ Add specific institute/entity and level here if applicable
    place: "Formación especializada en trauma y trabajo con el cuerpo",
  },
  // ✏️ Add more courses, conferences, supervision or certifications here
  // {
  //   year: "2023",
  //   title: "Curso de especialización en apego adulto",
  //   place: "Entidad formativa",
  // },
];

const VALORES = [
  {
    icon: "🔒",
    title: "Confidencialidad",
    description:
      "Todo lo que compartes en sesión queda dentro de la sesión. Es un espacio seguro, sin juicios.",
  },
  {
    icon: "🕊️",
    title: "Tu ritmo",
    description:
      "No hay prisa ni un camino único. Adapto el proceso a tus tiempos y necesidades, no al revés.",
  },
  {
    icon: "🔬",
    title: "Basado en evidencia",
    description:
      "Combino modelos con respaldo científico (terapia sensoriomotriz, enfoque integrador) con calidez humana.",
  },
  {
    icon: "🤝",
    title: "Cercanía real",
    description:
      "Nada de tecnicismos ni distancia clínica innecesaria. Hablamos como personas, no como paciente y experta.",
  },
];
---

<BaseLayout
  title="Sobre mí"
  description="Conoce a Maria José Duarte Barrio (Majo), psicóloga colegiada (Nº AO13522) especializada en trauma, apego y terapia Sensoriomotriz. Sesiones online."
  canonical="https://mariajoseduartepsicologa.site/sobre-mi"
>
  <!-- ==============================
       INTRO
  ============================== -->
  <section class="pt-10 pb-20 md:pb-24 bg-amber-50 relative overflow-hidden">
    <div
      class="absolute top-0 right-0 w-1/3 h-1/3 bg-teal-50 rounded-bl-[10rem] -z-10 opacity-60"
      aria-hidden="true"
    >
    </div>

    <div
      class="container mx-auto px-4 md:px-6 max-w-6xl grid lg:grid-cols-2 gap-16 items-center"
    >
      <div class="flex flex-col gap-6 reveal order-1 lg:order-none">
        <div
          class="flex items-center gap-3 text-rose-400 font-medium tracking-wide text-sm uppercase"
        >
          <span class="w-8 h-px bg-rose-400" aria-hidden="true"></span>
           Sobre mí
          <span class="w-8 h-px bg-rose-400" aria-hidden="true"></span>
        </div>

        <h1
          class="text-4xl md:text-5xl font-serif font-medium text-stone-900 leading-tight"
        >
          Soy Majo, psicóloga sanitaria, y me alegra que estés aquí.
        </h1>

        <div class="text-stone-600 text-lg leading-relaxed space-y-4">
          <p>
            Mi propósito es acompañarte en tu proceso de autoconocimiento y
            sanación. Creo firmemente que la terapia es un espacio de
            <strong>crecimiento personal</strong> donde no tienes que fingir
            ser fuerte todo el tiempo.
          </p>
          <p>
            Estoy especializada en <strong>trauma</strong> y
            <strong>acompañamiento emocional</strong>. Mi forma de trabajar
            parte de una idea muy importante: las experiencias difíciles que
            hemos vivido no solo se guardan en la mente, también dejan huella
            en el cuerpo y en las emociones.
          </p>
          <p>
            Quizá has llegado hasta aquí porque hay algo que últimamente no termina de estar bien.
          </p>
          <p>
            Puede que estés sintiendo ansiedad, que te cueste parar y descansar, que seas demasiado exigente contigo o que te cueste entender lo que necesitas.
          </p>
          <p>
            Quizá hay cosas de tu pasado que todavía pesan, experiencias que te han dejado huella o momentos de cambio, pérdida o incertidumbre que te están resultando difíciles de atravesar.
          </p> 
          <p>
            O simplemente sientes que necesitas un espacio para parar, escucharte y empezar a cuidarte de otra manera.
            <b>Si te has sentido identificada con alguna de estas situaciones, estás en el lugar adecuado.</b>
          </p>
        </div>

        <div class="flex flex-wrap gap-3 mt-2">
          <span class="text-xs font-medium text-teal-800 bg-teal-50 px-3 py-1.5 rounded-full">
            Nº Colegiada AO13522
          </span>
          <span class="text-xs font-medium text-teal-800 bg-teal-50 px-3 py-1.5 rounded-full">
            Máster en Psicología General Sanitaria
          </span>
          <span class="text-xs font-medium text-teal-800 bg-teal-50 px-3 py-1.5 rounded-full">
            +5 años de experiencia
          </span>
        </div>

        <a
          href="/#contacto"
          class="inline-flex items-center justify-center gap-2 bg-rose-300 hover:bg-rose-400 text-white px-8 py-4 rounded-full font-medium transition-all shadow-lg shadow-teal-700/20 hover:shadow-teal-700/40 hover:-translate-y-0.5 w-fit mt-2"
        >
          Reserva tu primera sesión
        </a>
      </div>

      <div class="reveal order-2 lg:order-none">
        <div
          class="aspect-[4/5] max-w-md mx-auto relative rounded-[2rem] overflow-hidden shadow-xl"
        >
          <Image src={majofoto} alt="Maria José Duarte Barrio, psicóloga" width={480} height={600} />
        </div>
        <div
          class="absolute -bottom-8 -right-8 bg-rose-300 text-white p-6 rounded-2xl shadow-xl max-w-[200px] hidden md:block"
        >
          <p class="text-3xl font-serif font-medium mb-1">+5</p>
          <p class="text-sm leading-tight">
            Años de experiencia sanitaria ayudando a personas
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ==============================
       METHODOLOGY & APPROACH
  ============================== -->
  <section class="py-12 bg-stone-50">
    <div class="container mx-auto px-4 md:px-6 max-w-6xl">
      <div class="reveal">
        <h2 class="text-3xl md:text-4xl font-serif font-medium text-stone-900 leading-tight">
          Mi forma de trabajar
        </h2>
        <div class="text-stone-600 text-lg leading-relaxed space-y-4">
          <p>
            Mi trabajo consiste en acompañarte a entender mejor lo que te está pasando, no solo desde lo que piensas, sino también desde lo que sientes y desde cómo lo vive tu cuerpo.
          </p>
          <p>
            Estoy especializada en <b>trauma y acompañamiento emocional</b>, y mi formación incluye el <b>Máster en Psicología General Sanitaria</b> y el <b>experto en Trauma</b> de la Universidad de Alcalá de Henares.
          </p>
          <p>
            A lo largo de mi trayectoria me he formado también en <b>Terapia Sensoriomotriz (Nivel II)</b>, intervención en trauma y emergencias, duelo, neurodivergencias (Autismo, TDAH, Altas capacidades), autolesión e ideación suicida, dolor emocional y crónico desde una perspectiva biopsicosocial, violencia en la pareja, somatizaciones digestivas y salud mental, además de intervención en crisis y acompañamiento psicológico.
          </p>
          <p>
            Para mí, seguir formándome es una parte importante de mi trabajo. Cada persona es diferente y, por eso, creo que la terapia no debería ser un “mismo método para todo el mundo”.
          </p>
        </div>
        <h3 class="text-xl md:text-2xl font-serif font-medium text-stone-900 mt-10">¿Por qué un enfoque integrador?</h3>
        <div class="text-stone-600 text-lg leading-relaxed space-y-4">
          <p>
            Porque <b>tú eres mucho más que un diagnóstico o un problema concreto.</b>
          </p>
          <p>
            Un enfoque integrador me permite conocer tu historia, tus necesidades y 
            tu manera particular de vivir lo que te está pasando, para ir escogiendo 
            las herramientas que puedan ayudarte más en cada momento.
          </p>
          <p>
            No todas las personas necesitan lo mismo, ni responden de la misma manera
            a una determinada forma de trabajar. Por eso, para mí es importante poder
            ser flexible y no quedarme encerrada en una única perspectiva.            
          </p>
          <p>
            Integro diferentes conocimientos y herramientas para poder mirar lo que ocurre
            desde distintos lugares: <b>lo que piensas, lo que sientes, lo que haces
            y lo que ocurre en tu cuerpo.</b> Y, especialmente cuando hablamos de experiencias
            difíciles o de trauma, esta mirada más amplia puede ayudarnos a comprender 
            por qué a veces sabemos racionalmente que estamos bien, pero nuestro cuerpo 
            sigue reaccionando como si tuviera que protegerse.            
          </p>
          <p>
            Mi intención es que la terapia sea un espacio en el que podamos ir encontrando,
            juntas, qué necesitas y qué puede ayudarte realmente. <b>Sin fórmulas rígidas,
            respetando tu ritmo y adaptándonos a ti.</b>
          </p>
        </div>
        <a
          href="/terapias"
          class="inline-flex items-center justify-center gap-2 bg-rose-300 hover:bg-rose-400 text-white px-8 py-4 rounded-full font-medium transition-all shadow-lg shadow-teal-700/20 hover:shadow-teal-700/40 hover:-translate-y-0.5 w-fit mt-8"
        >
          Ver cómo trabajo cada terapia
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 12h14" /><path d="m12 5 7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ==============================
       CORE VALUES
  ============================== -->
  <section class="py-24 bg-amber-50">
    <div class="container mx-auto px-4 md:px-6 max-w-6xl">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="text-3xl md:text-4xl font-serif font-medium text-stone-900 mb-6">
          Cómo trabajo
        </h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {
          VALORES.map((valor) => (
            <div class="reveal bg-stone-50 p-6 rounded-2xl border border-stone-100 text-center">
              <div class="text-3xl mb-4" aria-hidden="true">{valor.icon}</div>
              <h3 class="font-semibold text-stone-900 mb-2">{valor.title}</h3>
              <p class="text-sm text-stone-600 leading-relaxed">{valor.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ==============================
       FINAL CTA
  ============================== -->
  <section class="py-20 bg-stone-50">
    <div class="container mx-auto px-4 md:px-6 max-w-4xl">
      <div
        class="reveal flex flex-col items-center bg-amber-50 p-8 md:p-12 rounded-[2rem] border border-rose-400 text-center"
      >
        <h3 class="text-2xl font-serif font-medium text-stone-900 mb-4">
          ✨ ¿Hablamos? ✨
        </h3>
        <p class="text-stone-600 mb-8 max-w-xl">
          Si sientes que este es el momento de pedir ayuda, estoy aquí para
          acompañarte. La primera sesión informativa es gratuita.
        </p>
        <a
          href="/#contacto"
          class="inline-flex items-center justify-center bg-rose-300 hover:bg-rose-400 text-white px-8 py-4 rounded-full font-medium transition-all"
        >
          Reserva tu sesión informativa gratuita
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.6s ease,
      transform 0.6s ease;
  }
  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add("visible");
          observer.unobserve(e.target);
        }
      }),
    { threshold: 0.08 },
  );
  document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
</script>