            "description": "Psicóloga General Sanitaria colegiada (Nº AO13522). Especializada en terapia online, trauma, apego, terapia sensoriomotriz y acompañamiento a personas adultas neurodivergentes.",
            "url": "https://mariajoseduartepsicologa.com",
            "telephone": "+34616312699",
            "email": "mjduarte.psicologa@gmail.com",
            "hasCredential": [
              {
                "@type": "EducationalOccupationalCredential",
                "credentialCategory": "Colegiación Profesional",
                "recognizedBy": {
                  "@type": "Organization",
                  "name": "Colegio Oficial de Psicología de Andalucía Oriental (COPAO)"
                },
                "identifier": "AO13522"
              }
            ],
            "knowsAbout": [
              "Psicoterapia online",
              "Terapia Sensoriomotriz",
              "Trauma y apego",
              "Neurodivergencia en personas adultas",
              "Ansiedad y regulación emocional"
            ],
            "sameAs": [
              "https://www.doctoralia.es/perfil/maria-jose-duarte-barrio",
              "https://www.linkedin.com/in/mar%C3%ADa-jos%C3%A9-duarte-34864125b/",
              "https://www.instagram.com/majoduartepsico/"
            ]
          },
          {
            "@type": ["Psychologist", "MedicalBusiness"],
            "@id": "https://mariajoseduartepsicologa.com/#organization",
            "name": "Maria José Duarte Barrio · Psicología Sanitaria",
            "description": "Acompañamiento psicológico profesional online. Especializada en trauma, apego, terapia sensoriomotriz y neurodivergencia en adultos.",
            "url": "https://mariajoseduartepsicologa.com",
            "telephone": "+34616312699",
            "email": "mjduarte.psicologa@gmail.com",
            "priceRange": "€€",
            "currenciesAccepted": "EUR",
            "paymentAccepted": "Transferencia bancaria",
            "openingHours": "Mo-Fr 09:00-20:00",
            "medicalSpecialty": "Psychology",
            "sameAs": [
              "https://www.doctoralia.es/perfil/maria-jose-duarte-barrio",
              "https://www.linkedin.com/in/mar%C3%ADa-jos%C3%A9-duarte-34864125b/",
              "https://www.instagram.com/majoduartepsico/"
            ],
            "areaServed": [
              {
                "@type": "Country",
                "name": "España"
              },
              {
                "@type": "AdministrativeArea",
                "name": "Online"
              }
            ],
            "address": {
              "@type": "PostalAddress",
              "streetAddress": "Calle Salitre",
              "addressLocality": "Málaga",
              "addressRegion": "Málaga",
              "postalCode": "29002",
              "addressCountry": "ES"
            },
            "geo": {
              "@type": "GeoCoordinates",
              "latitude": "36.7134",
              "longitude": "-4.4287"
            },
            "founder": {
              "@id": "https://mariajoseduartepsicologa.com/#person"
            }
          }
        ]
      }
    </script>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400;1,500&family=DM+Sans:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body
    class="min-h-screen flex flex-col font-sans bg-stone-50 text-stone-800 selection:bg-teal-200"
  >
    <!-- HEADER -->
    <header
      id="site-header"
      class="fixed top-0 w-full z-50 transition-all duration-300 py-5 bg-transparent"
    >
      <div
        class="container mx-auto px-4 md:px-6 max-w-6xl flex justify-between items-center"
      >
        <!-- Logo -->
        <a
          href="/#inicio"
          class="flex items-center gap-2 group"
          aria-label="Ir al inicio"
        >
          <div
            class="w-10 h-10"
          >
            <Logo />
          </div>
          <div class="flex flex-col">
            <span class="font-serif font-medium text-lg leading-tight"
              >Maria José Duarte Barrio</span
            >
            <span
              class="text-xs text-stone-500 uppercase tracking-wider font-medium"
              >Psicología Sanitaria</span
            >
          </div>
        </a>

        <!-- Desktop Navigation -->
        <nav
          class="hidden lg:flex items-center gap-8"
          aria-label="Navegación principal"
        >
          <div class="flex items-center gap-6">
            {
              NAV_LINKS.map((link) => (
                <a
                  href={link.href}
                  class="text-sm font-medium text-stone-600 hover:text-teal-700 transition-colors"
                >
                  {link.label}
                </a>
              ))
            }
          </div>
          <a
            href="/#contacto"
            class="px-5 py-2.5 bg-rose-300 text-white text-sm font-medium rounded-full hover:bg-rose-400 transition-colors shadow-sm hover:shadow-md"
          >
            Reserva tu cita
          </a>
        </nav>

        <!-- Mobile Button -->
        <button
          id="menu-toggle"
          class="lg:hidden p-2 text-stone-600"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg
            id="icon-menu"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            viewBox="0 0 24 24"
            ><line x1="4" x2="20" y1="12" y2="12"></line><line
              x1="4"
              x2="20"
              y1="6"
              y2="6"></line><line x1="4" x2="20" y1="18" y2="18"></line></svg
          >
          <svg
            id="icon-close"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            viewBox="0 0 24 24"
            class="hidden"
            ><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg
          >
        </button>
      </div>
    </header>

    <!-- Mobile Menu -->
    <div
      id="mobile-menu"
      class="fixed inset-0 z-40 bg-white pt-24 pb-6 px-6 lg:hidden flex-col gap-6 overflow-y-auto hidden"
      role="dialog"
      aria-modal="true"
      aria-label="Menú de navegación móvil"
    >
      <nav
        class="flex flex-col gap-6 text-center mt-8"
        aria-label="Navegación móvil"
      >
        {
          NAV_LINKS.map((link) => (
            <a
              href={link.href}
              class="mobile-nav-link text-lg font-medium text-stone-800 hover:text-teal-700 transition-colors"
            >
              {link.label}
            </a>
          ))
        }
        <a
          href="/#contacto"
          class="mobile-nav-link mt-4 mx-auto px-8 py-3 bg-rose-400 text-white font-medium rounded-full w-full max-w-xs hover:bg-rose-500 transition-colors"
        >
          Reserva tu cita
        </a>
      </nav>
    </div>

    <!-- MAIN CONTENT -->
    <main class="flex-1 flex flex-col pt-24">
      <slot />
    </main>

    <!-- FOOTER -->
    <footer class="bg-stone-900 text-stone-300 py-12 border-t border-stone-800">
      <div
        class="container mx-auto px-4 md:px-6 max-w-6xl grid grid-cols-1 md:grid-cols-4 gap-10"
      >
        <div class="col-span-1 md:col-span-2">
          <div class="flex items-center gap-2 mb-4 opacity-90">
            <Logo class="w-12 h-12" />
            <span class="font-serif font-medium text-xl text-white"
              >Maria José Duarte Barrio</span
            >
          </div>
          <p class="text-stone-400 mb-6 max-w-md">
            Acompañamiento psicológico profesional para ayudarte a encontrar el
            equilibrio emocional y construir una vida más plena en modalidad 100% online.
          </p>
          <div class="flex items-center gap-3 text-xs text-stone-400">
            <a
              href="https://www.doctoralia.es/perfil/maria-jose-duarte-barrio"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-teal-400 transition-colors"
            >
              Doctoralia
            </a>
            <span class="text-stone-600">·</span>
            <a
              href="https://www.linkedin.com/in/mar%C3%ADa-jos%C3%A9-duarte-34864125b/"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-teal-400 transition-colors"
            >
              LinkedIn
            </a>
            <span class="text-stone-600">·</span>
            <a
              href="https://www.instagram.com/majoduartepsico/"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-teal-400 transition-colors"
            >
              Instagram
            </a>
          </div>
        </div>

        <div>
          <h4
            class="text-white font-medium mb-4 uppercase tracking-wider text-sm"
          >
            Enlaces
          </h4>
          <ul class="flex flex-col gap-2 text-sm">
            <li>
              <a href="/sobre-mi/" class="hover:text-teal-400 transition-colors"
                >Sobre mí</a
              >
            </li>
            <li>
              <a
                href="/terapias/"
                class="hover:text-teal-400 transition-colors">Terapias</a
              >
            </li>
            <li>
              <a href="/#tarifas" class="hover:text-teal-400 transition-colors"
                >Tarifas</a
              >
            </li>
            <li>
              <a href="/blog/" class="hover:text-teal-400 transition-colors"
                >Blog</a
              >
            </li>
          </ul>
        </div>

        <div>
          <h4
            class="text-white font-medium mb-4 uppercase tracking-wider text-sm"
          >
            Contacto
          </h4>
          <ul class="flex flex-col gap-2 text-sm">
            <li>
              <a
                href="mailto:mjduarte.psicologa@gmail.com"
                class="hover:text-teal-400 transition-colors"
                >mjduarte.psicologa@gmail.com</a
              >
            </li>
            <li>
              <a
                href="tel:+34616312699"
                class="hover:text-teal-400 transition-colors">+34 616 31 26 99</a
              >
            </li>
            <li>Terapia 100% online</li>
            <li class="text-xs text-stone-500 pt-1">Col. Nº AO13522 (COPAO)</li>
          </ul>
        </div>
      </div>

      <div
        class="container mx-auto px-4 md:px-6 max-w-6xl mt-12 pt-8 border-t border-stone-800 text-sm text-center md:text-left flex flex-col md:flex-row justify-between text-stone-500"
      >
        <p>
          &copy; <span id="year"></span> Maria José Duarte Barrio
          Psicología. Todos los derechos reservados.
        </p>
        <div class="flex gap-4 mt-4 md:mt-0 justify-center">
          <a href="/aviso-legal/" class="hover:text-stone-300">Aviso Legal</a>
          <a href="/politica-de-privacidad/" class="hover:text-stone-300">Privacidad</a>
          <a href="/cookies/" class="hover:text-stone-300">Cookies</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<script>
  // Dynamic year
  document.getElementById("year")!.textContent = new Date()
    .getFullYear()
    .toString();

  // Header scroll
  const header = document.getElementById("site-header")!;
  window.addEventListener(
    "scroll",
    () => {
      if (window.scrollY > 20) {
        header.classList.add(
          "bg-white/90",
          "backdrop-blur-md",
          "shadow-sm",
          "py-3",
        );
        header.classList.remove("bg-transparent", "py-5");
      } else {
        header.classList.remove(
          "bg-white/90",
          "backdrop-blur-md",
          "shadow-sm",
          "py-3",
        );
        header.classList.add("bg-transparent", "py-5");
      }
    },
    { passive: true },
  );

  // Mobile menu
  const toggle = document.getElementById("menu-toggle")!;
  const menu = document.getElementById("mobile-menu")!;
  const iconMenu = document.getElementById("icon-menu")!;
  const iconClose = document.getElementById("icon-close")!;

  toggle.addEventListener("click", () => {
    const isOpen = !menu.classList.contains("hidden");
    menu.classList.toggle("hidden");
    menu.classList.toggle("flex");
    iconMenu.classList.toggle("hidden", !isOpen);
    iconClose.classList.toggle("hidden", isOpen);
    toggle.setAttribute("aria-expanded", String(!isOpen));
    document.body.style.overflow = isOpen ? "" : "hidden";
  });

  // Close mobile menu on link click
  document.querySelectorAll(".mobile-nav-link").forEach((link) => {
    link.addEventListener("click", () => {
      menu.classList.add("hidden");
      menu.classList.remove("flex");
      iconMenu.classList.remove("hidden");
      iconClose.classList.add("hidden");
      toggle.setAttribute("aria-expanded", "false");
      document.body.style.overflow = "";
    });
  });
</script>
