---
interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical = Astro.url.href,
  ogImage = "/og-default.jpg",
  ogType = "website",
  noindex = false,
} = Astro.props;

const siteName = "María José Duarte Barrio · Psicología Sanitaria";
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;

const NAV_LINKS = [
  { label: "Inicio", href: "/#inicio" },
  { label: "Sobre mí", href: "/#sobre-mi" },
  { label: "Servicios", href: "/#servicios" },
  { label: "Cómo funciona", href: "/#como-funciona" },
  { label: "Tarifas", href: "/#tarifas" },
  { label: "FAQ", href: "/#faq" },
  { label: "Blog", href: "/blog" },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO primario -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Schema.org LocalBusiness -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "MedicalBusiness",
        "name": "María José Duarte Barrio · Psicología Sanitaria",
        "description": "Acompañamiento psicológico profesional online y presencial en Málaga. Especializada en ansiedad, depresión y terapia de pareja.",
        "url": "https://mariajoseduartebarriopsicologia.com",
        "telephone": "+34600000000",
        "email": "info@mariajoseduartebarriopsicologia.com",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Calle Salitre",
          "addressLocality": "Málaga",
          "addressCountry": "ES"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": "40.4286",
          "longitude": "-3.7130"
        },
        "priceRange": "€€",
        "openingHours": "Mo-Fr 09:00-20:00",
        "medicalSpecialty": "Psychiatry",
        "sameAs": []
      }
    </script>

    <!-- Fuentes -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400;1,500&family=DM+Sans:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body
    class="min-h-screen flex flex-col font-sans bg-stone-50 text-stone-800 selection:bg-teal-200"
  >
    <!-- HEADER -->
    <header
      id="site-header"
      class="fixed top-0 w-full z-50 transition-all duration-300 py-5 bg-transparent"
    >
      <div
        class="container mx-auto px-4 md:px-6 max-w-6xl flex justify-between items-center"
      >
        <!-- Logo -->
        <a
          href="/#inicio"
          class="flex items-center gap-2 group"
          aria-label="Ir al inicio"
        >
          <div
            class="bg-teal-700 text-white p-2 rounded-xl group-hover:bg-teal-600 transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                d="M9.5 2A2.5 2.5 0 0 1 12 4.5v15a2.5 2.5 0 0 1-4.96-.44 2.5 2.5 0 0 1-2.96-3.08 3 3 0 0 1-.34-5.58 2.5 2.5 0 0 1 1.32-4.24 2.5 2.5 0 0 1 1.98-3A2.5 2.5 0 0 1 9.5 2Z"
              ></path>
              <path
                d="M14.5 2A2.5 2.5 0 0 0 12 4.5v15a2.5 2.5 0 0 0 4.96-.44 2.5 2.5 0 0 0 2.96-3.08 3 3 0 0 0 .34-5.58 2.5 2.5 0 0 0-1.32-4.24 2.5 2.5 0 0 0-1.98-3A2.5 2.5 0 0 0 14.5 2Z"
              ></path>
            </svg>
          </div>
          <div class="flex flex-col">
            <span class="font-serif font-medium text-lg leading-tight"
              >María José Duarte Barrio</span
            >
            <span
              class="text-xs text-stone-500 uppercase tracking-wider font-medium"
              >Psicología Sanitaria</span
            >
          </div>
        </a>

        <!-- Nav escritorio -->
        <nav
          class="hidden lg:flex items-center gap-8"
          aria-label="Navegación principal"
        >
          <div class="flex items-center gap-6">
            {
              NAV_LINKS.map((link) => (
                <a
                  href={link.href}
                  class="text-sm font-medium text-stone-600 hover:text-teal-700 transition-colors"
                >
                  {link.label}
                </a>
              ))
            }
          </div>
          <a
            href="/#contacto"
            class="px-5 py-2.5 bg-teal-700 text-white text-sm font-medium rounded-full hover:bg-teal-800 transition-colors shadow-sm hover:shadow-md"
          >
            Reserva tu cita
          </a>
        </nav>

        <!-- Botón móvil -->
        <button
          id="menu-toggle"
          class="lg:hidden p-2 text-stone-600"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg
            id="icon-menu"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            viewBox="0 0 24 24"
            ><line x1="4" x2="20" y1="12" y2="12"></line><line
              x1="4"
              x2="20"
              y1="6"
              y2="6"></line><line x1="4" x2="20" y1="18" y2="18"></line></svg
          >
          <svg
            id="icon-close"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            viewBox="0 0 24 24"
            class="hidden"
            ><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg
          >
        </button>
      </div>
    </header>

    <!-- Menú móvil -->
    <div
      id="mobile-menu"
      class="fixed inset-0 z-40 bg-white pt-24 pb-6 px-6 lg:hidden flex-col gap-6 overflow-y-auto hidden"
      role="dialog"
      aria-modal="true"
      aria-label="Menú de navegación móvil"
    >
      <nav
        class="flex flex-col gap-6 text-center mt-8"
        aria-label="Navegación móvil"
      >
        {
          NAV_LINKS.map((link) => (
            <a
              href={link.href}
              class="mobile-nav-link text-lg font-medium text-stone-800 hover:text-teal-700 transition-colors"
            >
              {link.label}
            </a>
          ))
        }
        <a
          href="/#contacto"
          class="mobile-nav-link mt-4 mx-auto px-8 py-3 bg-teal-700 text-white font-medium rounded-full w-full max-w-xs hover:bg-teal-800 transition-colors"
        >
          Reserva tu cita
        </a>
      </nav>
    </div>

    <!-- CONTENIDO PRINCIPAL -->
    <main class="flex-1 flex flex-col">
      <slot />
    </main>

    <!-- FOOTER -->
    <footer class="bg-stone-900 text-stone-300 py-12 border-t border-stone-800">
      <div
        class="container mx-auto px-4 md:px-6 max-w-6xl grid grid-cols-1 md:grid-cols-4 gap-10"
      >
        <div class="col-span-1 md:col-span-2">
          <div class="flex items-center gap-2 mb-4 opacity-90">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              class="text-teal-500"
              viewBox="0 0 24 24"
              ><path
                d="M9.5 2A2.5 2.5 0 0 1 12 4.5v15a2.5 2.5 0 0 1-4.96-.44 2.5 2.5 0 0 1-2.96-3.08 3 3 0 0 1-.34-5.58 2.5 2.5 0 0 1 1.32-4.24 2.5 2.5 0 0 1 1.98-3A2.5 2.5 0 0 1 9.5 2Z"
              ></path><path
                d="M14.5 2A2.5 2.5 0 0 0 12 4.5v15a2.5 2.5 0 0 0 4.96-.44 2.5 2.5 0 0 0 2.96-3.08 3 3 0 0 0 .34-5.58 2.5 2.5 0 0 0-1.32-4.24 2.5 2.5 0 0 0-1.98-3A2.5 2.5 0 0 0 14.5 2Z"
              ></path></svg
            >
            <span class="font-serif font-medium text-xl text-white"
              >María José Duarte Barrio</span
            >
          </div>
          <p class="text-stone-400 mb-6 max-w-md">
            Acompañamiento psicológico profesional para ayudarte a encontrar el
            equilibrio emocional y construir una vida más plena, tanto online
            como presencial.
          </p>
        </div>

        <div>
          <h4
            class="text-white font-medium mb-4 uppercase tracking-wider text-sm"
          >
            Enlaces
          </h4>
          <ul class="flex flex-col gap-2 text-sm">
            <li>
              <a href="/#sobre-mi" class="hover:text-teal-400 transition-colors"
                >Sobre mí</a
              >
            </li>
            <li>
              <a
                href="/#servicios"
                class="hover:text-teal-400 transition-colors">Servicios</a
              >
            </li>
            <li>
              <a href="/#tarifas" class="hover:text-teal-400 transition-colors"
                >Tarifas</a
              >
            </li>
            <li>
              <a href="/blog" class="hover:text-teal-400 transition-colors"
                >Blog</a
              >
            </li>
          </ul>
        </div>

        <div>
          <h4
            class="text-white font-medium mb-4 uppercase tracking-wider text-sm"
          >
            Contacto
          </h4>
          <ul class="flex flex-col gap-2 text-sm">
            <li>
              <a
                href="mailto:info@mariajoseduartebarriopsicologia.com"
                class="hover:text-teal-400 transition-colors"
                >info@mariajoseduartebarriopsicologia.com</a
              >
            </li>
            <li>
              <a
                href="tel:+34600000000"
                class="hover:text-teal-400 transition-colors">+34 600 000 000</a
              >
            </li>
            <li>Málaga, España (y Online)</li>
          </ul>
        </div>
      </div>

      <div
        class="container mx-auto px-4 md:px-6 max-w-6xl mt-12 pt-8 border-t border-stone-800 text-sm text-center md:text-left flex flex-col md:flex-row justify-between text-stone-500"
      >
        <p>
          &copy; <span id="year"></span> María José Duarte Barrio
          Psicología. Todos los derechos reservados.
        </p>
        <div class="flex gap-4 mt-4 md:mt-0 justify-center">
          <a href="/aviso-legal" class="hover:text-stone-300">Aviso Legal</a>
          <a href="/privacidad" class="hover:text-stone-300">Privacidad</a>
          <a href="/cookies" class="hover:text-stone-300">Cookies</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<script>
  // Año dinámico
  document.getElementById("year")!.textContent = new Date()
    .getFullYear()
    .toString();

  // Header scroll
  const header = document.getElementById("site-header")!;
  window.addEventListener(
    "scroll",
    () => {
      if (window.scrollY > 20) {
        header.classList.add(
          "bg-white/90",
          "backdrop-blur-md",
          "shadow-sm",
          "py-3",
        );
        header.classList.remove("bg-transparent", "py-5");
      } else {
        header.classList.remove(
          "bg-white/90",
          "backdrop-blur-md",
          "shadow-sm",
          "py-3",
        );
        header.classList.add("bg-transparent", "py-5");
      }
    },
    { passive: true },
  );

  // Menú móvil
  const toggle = document.getElementById("menu-toggle")!;
  const menu = document.getElementById("mobile-menu")!;
  const iconMenu = document.getElementById("icon-menu")!;
  const iconClose = document.getElementById("icon-close")!;

  toggle.addEventListener("click", () => {
    const isOpen = !menu.classList.contains("hidden");
    menu.classList.toggle("hidden");
    menu.classList.toggle("flex");
    iconMenu.classList.toggle("hidden", !isOpen);
    iconClose.classList.toggle("hidden", isOpen);
    toggle.setAttribute("aria-expanded", String(!isOpen));
    document.body.style.overflow = isOpen ? "" : "hidden";
  });

  // Cerrar menú al hacer click en un enlace
  document.querySelectorAll(".mobile-nav-link").forEach((link) => {
    link.addEventListener("click", () => {
      menu.classList.add("hidden");
      menu.classList.remove("flex");
      iconMenu.classList.remove("hidden");
      iconClose.classList.add("hidden");
      toggle.setAttribute("aria-expanded", "false");
      document.body.style.overflow = "";
    });
  });
</script>
